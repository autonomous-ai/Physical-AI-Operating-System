+//! Wire checks use socket pairs and reported observations, never process signals.
+use super::*;
+use std::io::Read;
+use std::thread;
+
+const WATCHDOG: Duration = Duration::from_secs(2);
+const ROLES: [Role; 4] = [
+    Role::Runtime,
+    Role::Relay,
+    Role::ServeRuntime,
+    Role::ServeRelay,
+];
+
+fn step(round: u64, at_us: u64) -> Step {
+    Step {
+        round,
+        at_us,
+        stdout_target: 0,
+        runner_input_target: 0,
