+        if let Progress::ServeRuntime {
+            stdout_frames,
+            room_consumed,
+            room_injected,
+            cycle,
+            cycle_base_us,
+            runtime_us,
+            ..
+        } = &mut next
+        {
+            match counter {
+                0 => *stdout_frames -= 1,
+                1 => *room_consumed -= 1,
+                2 => *room_injected -= 1,
+                3 => *cycle -= 1,
+                4 => {
+                    *cycle += 1;
+                    *cycle_base_us -= 1;
+                }
+                5 => *runtime_us -= 1,
+                _ => unreachable!(),
+            }
+        }
+        assert!(
+            validate_progress(Role::ServeRuntime, Some(previous), step(2, 200), next).is_err(),
+            "counter {counter}"
+        );
+    }
+    let mut changed_base = runtime(2);
+    if let Progress::ServeRuntime { cycle_base_us, .. } = &mut changed_base {
+        *cycle_base_us += 1;
+    }
+    assert!(
+        validate_progress(
+            Role::ServeRuntime,
+            Some(previous),
+            step(2, 200),
+            changed_base
+        )
+        .is_err()
+    );
+
+    let mut restarted = runtime(2);
+    if let Progress::ServeRuntime {
+        cycle,
+        cycle_base_us,
+        runtime_us,
+        ..
+    } = &mut restarted
+    {
+        *cycle = 2;
+        *cycle_base_us = 200;
+        *runtime_us = 0;
+    }
+    assert!(validate_progress(Role::ServeRuntime, Some(previous), step(2, 200), restarted).is_ok());
+    assert!(
+        validate_progress(Role::ServeRuntime, Some(previous), step(2, 150), runtime(2)).is_ok()
+    );
