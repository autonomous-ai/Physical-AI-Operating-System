+        let clock = participant.clock();
+        for _ in 0..32 {
+            assert_eq!(clock.now().as_micros(), 100);
+        }
+        assert_eq!(
+            participant.complete(recorder(1, 100, 200, false)).unwrap(),
+            step(2, 100)
+        );
+        for _ in 0..32 {
+            assert_eq!(clock.now().as_micros(), 100);
+        }
+        assert_eq!(
+            participant.complete(recorder(2, 100, 200, false)).unwrap(),
+            step(3, 200)
