+fn close_and_join(
+    fixture: &mut ClockedServeFixture,
+    workers: impl IntoIterator<Item = JoinHandle<()>>,
+) {
+    fixture.close();
+    for worker in workers {
+        worker.join().unwrap();
+    }
+}
