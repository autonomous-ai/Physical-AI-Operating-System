+    let (release, released) = mpsc::sync_channel(1);
+    let (completed, completion) = mpsc::sync_channel(1);
+    thread::scope(|scope| {
+        let worker = scope.spawn(move || {
+            let clock = Clock::new();
+            let mut schedule = Schedule {
+                clock: clock.clone(),
+                reads: Arc::new(AtomicUsize::new(0)),
+                wait: |cycle: ReportCycle, remaining| {
