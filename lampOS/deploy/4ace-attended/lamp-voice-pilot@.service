# Attended 4ace pilot. Remote installation of this stopped unit is authorized.
# Starting requires the separately reviewed stationary handover and preflight.
# No automatic legacy stop/start, motor policy, restart or boot activation.
[Unit]
Description=Attended Rust Lamp 4ace pilot (%i)
ConditionHost=lamp-4ace
After=network-online.target

[Service]
Type=exec
User=root
Group=root
Slice=system.slice
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/releases/b1c61a224ea9958eeaa5f06b87fdc7591128da3daf01c21e2f3c851a7643edbd/lamp-voice serve /etc/lampOS/pilot-4ace/provider.json /var/lib/lampOS/pilot-4ace/sessions/%i --noise-suppression off --turn-taking v1-baseline --reference-clock capture --reference-recovery off --playout-start-ms 200 --ring-channel-ceiling 12
Restart=no
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-voice-pilot-%i
NoNewPrivileges=yes
# Defense in depth only: no motor worker is launched, and this is not a
# mechanical stop or proof of placement. Keep the separate legacy guard intact.
InaccessiblePaths=/dev/ttyACM0
