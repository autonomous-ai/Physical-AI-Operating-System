+fn child_case(test: &str) -> Option<ChildCase> {
+    if std::env::var(CHILD_TEST).is_ok_and(|value| value == test) {
+        Some(serde_json::from_str(&std::env::var(CHILD_CASE).unwrap()).unwrap())
+    } else {
