+            .prepare_with_ns_clock(wav, timing, cancel_file, max_wait_ms, move |phase| {
+                now().as_micros().checked_mul(1000).ok_or_else(|| {
+                    invalid(&format!("fake prepared {phase} time overflows nanoseconds"))
+                })
+            })
+    }
+}
