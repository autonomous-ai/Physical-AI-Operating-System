+const WATCHDOG: Duration = Duration::from_secs(2);
+const CHILD_BOUND: Duration = Duration::from_secs(10);
+const EPOCH_US: u64 = 1_000_000;
+const CHILD_TEST: &str = "LAMVE_SLOW_TRANSPORT_ADAPTER_OWNED_TEST";
