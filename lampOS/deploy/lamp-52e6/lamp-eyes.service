# lamp-52e6: deploy/lamp-4ace/lamp-eyes.service as lamp-4ace runs it, with this
# lamp's name and build, as a part of lampos.target (docs/keeper.md).
[Unit]
PartOf=lampos.target
Description=lampOS eyes (lamp-eyes)
ConditionHost=lamp-52e6
After=lamp-voice.service

[Service]
Type=exec
User=orangepi
Group=orangepi
SupplementaryGroups=video
WorkingDirectory=/
RuntimeDirectory=lampos-eyes
RuntimeDirectoryMode=0755
# Looking is never worth a late word: below the voice service.
Nice=10
Environment=LAMP_BUS=on
ExecStart=/opt/lampOS/eyes/22aa4eaa25ccb03e6226f11772cab8f4892b714e1aeb7690829ae625a1d5484f/lamp-eyes --device /dev/video0 --lock-directory /home/orangepi/.local/share/lampOS-voice/camera-locks --usb 01da:5875@3-1.1.4 --model /opt/lampOS/eyes/face_detection_yunet_2023mar.onnx --permit-socket /run/lampos-eyes/permit.sock --body-socket /run/lampos-body/gaze.sock --presence-file /run/lampos-eyes/present --sight-file /run/lampos-eyes/sight.jpg
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-eyes
NoNewPrivileges=yes

[Install]
WantedBy=lampos.target
