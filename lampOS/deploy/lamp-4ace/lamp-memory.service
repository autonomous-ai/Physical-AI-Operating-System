# lampOS memory: what the lamp remembers from one day to the next (lampOS/docs/memory.md).
# Its own process and unit. With it stopped the voice talks on and says it cannot remember just now.
# It is the only reader and writer of /var/lib/lampos-memory. Nothing is sent anywhere from here.
[Unit]
Description=lampOS memory (lamp-memory)

[Service]
Type=simple
User=orangepi
Group=orangepi
StateDirectory=lampos-memory
StateDirectoryMode=0700
RuntimeDirectory=lampos-memory
RuntimeDirectoryMode=0755
ExecStart=/opt/lampOS/memory/0bb039dd6b90dba87139e3aaac32d040a572f5b77d6d25e3611f3b012b409ed2/lamp-memory --dir /var/lib/lampos-memory --socket /run/lampos-memory/memory.sock --keep-days 30 --utc-offset-minutes 420 --memory-days --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=2s
SyslogIdentifier=lamp-memory
NoNewPrivileges=yes
ProtectSystem=strict
# Its health report (task 28) is written to the bus.
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target
