+    assert_eq!(dropped[0]["active"], true);
+    assert_eq!(run.finished(1)["outcome"], "second_route_failed");
+    assert!(run.played(1).is_empty());
+    let turn = run
+        .seen
+        .live
+        .iter()
+        .rev()
+        .find_map(|i| match i {
+            ProviderInput::Start { request, .. } => Some(*request),
+            _ => None,
+        })
+        .unwrap();
+    assert!(turn > 1);
