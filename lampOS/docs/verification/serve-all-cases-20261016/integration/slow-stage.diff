+fn step(round: u64, at_us: u64) -> Step {
+    Step {
+        round,
+        at_us,
+        stdout_target: 0,
+        runner_input_target: 0,
+        wait_for_sigterm: false,
+    }
+}
+
+fn progress(poll_seq: u64, due: u64, ended: bool) -> Progress {
+    Progress::SlowTransport {
+        poll_seq,
+        wait_started_us: EPOCH_US,
+        exec_due_us: due,
+        logical_end: ended,
+    }
+}
