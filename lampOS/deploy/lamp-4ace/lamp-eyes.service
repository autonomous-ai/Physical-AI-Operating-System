# lampOS eyes on lamp-4ace (the office lab prototype): finds a face in the head camera's picture
# and tells the body where it is, so the lamp can look at the person it is talking with.
# The camera opens only while lamp-voice.service keeps permitting it, which it does exactly while
# the microphone is permitted; it closes within 1.5 s of that stopping. With --sight-file the
# newest frame, and only that one, is kept in /run (memory) for lamp-voice to show the model with
# what a person says; take the option out and no frame leaves the process (lampOS/docs/eyes.md).
# Started at boot since 2026-10-15 (the V2 MVP: every part comes back after power).
[Unit]
Description=lampOS eyes (lamp-eyes)
ConditionHost=lamp-4ace
After=lamp-voice.service

[Service]
Type=exec
User=orangepi
Group=orangepi
SupplementaryGroups=video
WorkingDirectory=/
RuntimeDirectory=lampos-eyes
RuntimeDirectoryMode=0755
# The prints of people who asked the lamp to remember their face, and nobody else's (lampOS/docs/eyes.md, "Who is there").
StateDirectory=lampos-eyes
StateDirectoryMode=0700
# Looking is never worth a late word: below the voice service.
Nice=10
Environment=LAMP_BUS=on
ExecStart=/opt/lampOS/eyes/1b4aec19d224809c6bcb6eab1c75fc012be1ffdfc609b2cbce7c2e8f1a5176b8/lamp-eyes --device /dev/video0 --lock-directory /home/orangepi/.local/share/lampOS-voice/camera-locks --usb 01da:5875@3-1.1.4 --model /opt/lampOS/eyes/face_detection_yunet_2023mar.onnx --permit-socket /run/lampos-eyes/permit.sock --body-socket /run/lampos-body/gaze.sock --presence-file /run/lampos-eyes/present --sight-file /run/lampos-eyes/sight.jpg --recogniser /opt/lampOS/eyes/face_recognition_sface_2021dec.onnx --people /var/lib/lampos-eyes/people.json --who-socket /run/lampos-eyes/who.sock --known-file /run/lampos-eyes/known
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-eyes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
