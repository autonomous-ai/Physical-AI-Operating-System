# The reset (#806, docs/setup.md): the reset button held 5 s and released, as
# Controls publishes it on controls/touch (Controls runs with --touch and a
# reset line in its pins file). It stops the lamp with the keeper, wipes the
# person's data, removes the setup marker and reboots into setup.
[Unit]
Description=lampOS reset: the reset button held 5 s wipes the person's data
PartOf=lampos.target
After=lamp-controls.service

[Service]
Type=simple
# Root: the person's stores belong to several parts; the keeper stop; reboot.
User=root
ExecStart=/opt/lampOS/setup/BUILD/lamp-setup watch-reset --plan /etc/lampOS/setup/reset-plan.json --bus-root /run/lampos-bus --enable
Restart=on-failure
RestartSec=2

[Install]
WantedBy=lampos.target
