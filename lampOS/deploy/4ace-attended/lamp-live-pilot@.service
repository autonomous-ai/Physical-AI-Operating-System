# Attended 4ace pilot. Remote installation of this stopped unit is authorized.
# Starting requires the separately reviewed stationary handover and preflight.
# No automatic legacy stop/start, motor policy, restart or boot activation.
[Unit]
Description=Attended Rust Lamp 4ace pilot (%i)
ConditionHost=lamp-4ace
After=network-online.target

[Service]
Type=exec
User=root
Group=root
Slice=system.slice
WorkingDirectory=/
UMask=0077
ExecStart=/opt/lampOS/releases/738503a803d3718e52ca9e8886a669c0e41c007f7fe35873642afd4a83f5b8d0/lamp-live serve /etc/lampOS/pilot-4ace/provider.json /var/lib/lampOS/pilot-4ace/sessions/%i --noise-suppression off --turn-taking v1-baseline --reference-clock capture --reference-recovery off --playout-start-ms 200
Restart=no
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-live-pilot-%i
NoNewPrivileges=yes
# Defense in depth only: no motor worker is launched, and this is not a
# mechanical stop or proof of placement. Keep the separate legacy guard intact.
InaccessiblePaths=/dev/ttyACM0
