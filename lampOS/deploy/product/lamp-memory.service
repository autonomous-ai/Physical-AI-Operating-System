# lampOS memory: what the lamp keeps from one day to the next (lampOS/docs/memory.md). Its own user: no other part reads its records.
# The product unit (lampOS/docs/install.md).
[Unit]
Description=lampOS memory (lamp-memory)
PartOf=lampos.target
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos-memory
Group=lampos-memory
Slice=lampos-parts.slice
StateDirectory=lampos-memory
StateDirectoryMode=0700
RuntimeDirectory=lampos-memory
RuntimeDirectoryMode=0755
PrivateNetwork=yes
SupplementaryGroups=lampos
EnvironmentFile=/etc/lampOS/zone.env
ExecStart=/opt/lampOS/memory/current/lamp-memory --dir /var/lib/lampos-memory --socket /run/lampos-memory/memory.sock --keep-days 30 --utc-offset-minutes ${LAMP_UTC_OFFSET_MINUTES} --memory-days --bus-root /run/lampos-bus
Restart=on-failure
RestartSec=2s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-memory
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
