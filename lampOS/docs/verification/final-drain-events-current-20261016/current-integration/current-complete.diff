+                deadline_ms: 1000,
+                require_lamp_speaking: false,
+            },
+            expect: Expectation::Answer,
+            reference: String::new(),
+            addressed: Vec::new(),
+        };
+        // Granted at 10,000 us: well inside both bounds.
+        CLOCK.with(|times| *times.borrow_mut() = [10_000, 10_001].into());
+        let outcome = backend.grant(&step);
