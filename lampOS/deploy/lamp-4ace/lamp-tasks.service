# /etc/systemd/system/lamp-tasks.service
# lampOS tasks on lamp-4ace (lampOS/docs/tasks.md): work handed to Claude Code on another computer through Harness,
# started only after the person's spoken yes, which reaches it only on the voice's own socket.
# As the person (--harness-as-person): the owner chose the plain Harness CLI on 2026-10-14.
# Sessions run on other computers only: "lamp doesn't have enough resources" (owner, 2026-10-14).
[Unit]
Description=lampOS tasks (lamp-tasks)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=orangepi
Group=orangepi
Environment=HOME=/home/orangepi
Environment=PATH=/home/orangepi/.local/bin:/usr/local/bin:/usr/bin:/bin
RuntimeDirectory=lampos-tasks
RuntimeDirectoryMode=0700
StateDirectory=lampos-tasks
StateDirectoryMode=0700
# --progress puts how each task goes on the bus (tasks/status), which the voice's news reads (#1156);
# --push-wait holds Harness's own wait so a result is known within about 10 s of the agent ending (#560).
# On lamp-75c9 (Ten, 2026-10-16): 8.3 to 10.2 s against 39 to 41 s without, about 1 point more of
# the lamp's CPU, and one ~130 MB Node `harness wait` held while a task is watched.
ExecStart=/opt/lampOS/tasks/64b09e063e390ecb657fd68ea956d483f1820e0a811750aebc6596bbdaa26d83/lamp-tasks serve --enable --watch --progress --push-wait --harness-as-person --dir /var/lib/lampos-tasks/store --socket /run/lampos-tasks/request.sock --voice-socket /run/lampos-tasks/voice.sock --targets /var/lib/lampos-tasks/targets.json --harness /home/orangepi/.local/bin/harness
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
