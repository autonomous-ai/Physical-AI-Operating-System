+    controller.pump().unwrap();
+    assert!(matches!(
+        preparing.ready.try_recv(),
+        Err(TryRecvError::Empty)
+    ));
+    at.store(START_US + 3_000_000, Ordering::SeqCst);
+    controller.pump().unwrap();
+    assert!(matches!(
+        preparing.ready.try_recv(),
+        Err(TryRecvError::Empty)
+    ));
+    fixture.bind_room();
+    controller.pump().unwrap();
