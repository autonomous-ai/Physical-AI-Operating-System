+        let (_, at_us) = self.snapshot()?;
+        let until = at_us
+            .checked_add(u64::from(max_wait_ms) * 1000)
+            .ok_or_else(|| invalid("prepared fixture grant timeout overflow"))?;
+        let deadline = Instant::now() + CONTROL_BOUND;
