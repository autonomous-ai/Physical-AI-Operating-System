+            "rest".to_owned(),
+        ];
+        let (kept, rest) = take_keep_link(&flags);
+        assert!(kept);
+        let (wait, rest) = take_wait_for_room(rest);
+        assert!(wait);
+        assert_eq!(rest, ["rest"]);
+        assert!(!take_wait_for_room(rest).0);
+    }
