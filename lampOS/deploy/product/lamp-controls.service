# lampOS controls: the button and the touch pads: what a hand did, on the bus (lampOS/docs/controls.md).
# The product unit (lampOS/docs/install.md).
[Unit]
Description=lampOS controls (lamp-controls)
PartOf=lampos.target
After=lamp-voice.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=lampos
Group=lampos
Slice=lampos-parts.slice
Nice=5
ExecStart=/opt/lampOS/controls/current/lamp-controls serve --config /etc/lampOS/controls/controls.json --pins /etc/lampOS/controls/controls-pins.json --bus-root /run/lampos-bus --enable
Restart=on-failure
RestartSec=5s
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lamp-controls
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=lampos.target
