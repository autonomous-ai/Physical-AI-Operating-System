+fn finish_wait(result: Receiver<Result<()>>, worker: JoinHandle<()>) -> Result<()> {
+    let result = result
+        .recv_timeout(WATCHDOG)
+        .expect("bounded transport wait completion");
+    worker.join().unwrap();
+    result
+}
