+        assert_eq!(clock.now().as_micros(), 200);
+        participant.final_ack(recorder(3, 100, 200, true)).unwrap();
+        assert!(participant.final_ack(recorder(4, 100, 200, true)).is_err());
+    });
+    let mut parent = ParentPeer::from_stream(
+        parent,
+        Role::Recorder,
