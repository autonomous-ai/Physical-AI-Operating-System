+            let _ = self.peer.channels.control.send(WorkerEvent::Privacy {
+                acquired_at_us: monotonic_us(),
+                muted: self.muted.load(Ordering::SeqCst),
+            });
+            self.next = crate::scenario_clock::instant() + Duration::from_millis(5);
+        }
+        Ok(())
     }
