+    fn slow_prepare(&mut self, room: &Path, _: &Path, delay_ms: u32) -> Result<()> {
+        let deadline = Instant::now() + ROOM_BOUND;
+        loop {
+            let (round, _) = self.snapshot()?;
+            if room.exists() {
