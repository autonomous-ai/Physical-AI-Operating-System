+    }
+    assert!(validate_step(Role::Recorder, Some(step(1, 100)), step(2, 99)).is_err());
+    assert!(validate_step(Role::Recorder, Some(step(u64::MAX, 100)), step(0, 100)).is_err());
+    for poll_seq in [0, 1, 3] {
