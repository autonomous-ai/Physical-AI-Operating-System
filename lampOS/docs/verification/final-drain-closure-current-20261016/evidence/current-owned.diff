+                .stdout(Stdio::piped())
+                .spawn()
+                .unwrap(),
+        );
+        let (dropped, input_dropped) = mpsc::sync_channel(1);
+        let (release, proceed) = mpsc::sync_channel(1);
+        let (closed, notice) = mpsc::sync_channel(1);
+        let enqueued = Arc::new(AtomicU64::new(0));
+        let lines = relay_reader_with_progress_capacity_observed(
+            InputDropGate {
+                input: child.0.stdout.take(),
+                dropped,
+                release: proceed,
+            },
+            Some(enqueued.clone()),
