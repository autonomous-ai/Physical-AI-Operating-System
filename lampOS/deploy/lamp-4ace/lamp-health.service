# lampOS health: puts every part's own report together into "how is the lamp", and reads the board's
# temperature, load, memory and disk (lampOS/docs/health.md). Its own process and unit: with it stopped
# nothing else on the lamp changes. `lamp-health` with no arguments prints how the lamp is.
[Unit]
Description=lampOS health (lamp-health)
After=local-fs.target

[Service]
Type=simple
User=orangepi
Group=orangepi
# The parts that say how they are today. A part named here that never reports makes the lamp "stale".
# Of the board's thermal zones, the processors' and the skin's limits are judged: the graphics zone names a
# limit of 60 C and reads 64 at rest, and the lamp does not use it.
# `--online on`: lamp/online from the voice's link; `--reach-probe on`: while that link is down, a bare
# TCP handshake to 1.1.1.1:443 and 8.8.8.8:443 (nothing sent), so a relay outage is not said as no
# internet (lampOS/docs/offline.md, "The relay is not the internet"; #830, the first builder, 12:00).
ExecStart=/opt/lampOS/health/adcbb5df81bad58a700323bc5addd40aec3f89b5ef2a7640dabadad7f489d996/lamp-health serve --bus-root /run/lampos-bus --expect board --expect voice --expect eyes --expect body --expect policy --expect name --expect controls --expect expression --expect actions --expect ears --expect memory --expect schedule --expect air --judge-zone cpu --judge-zone skin --online on --reach-probe on
Restart=on-failure
RestartSec=5s
SyslogIdentifier=lamp-health
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/lampos-bus
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
