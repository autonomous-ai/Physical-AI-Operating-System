+        assert!(error.to_string().contains(expected), "{error}");
+        assert!(!fixture.out.exists());
+    }
+}
+
+#[test]
+fn explicit_timing_checks_both_nanosecond_boundaries_without_wrapping() {
+    let fixture = Fixture::new();
